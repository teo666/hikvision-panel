# Le camere si aggiungono dalla pagina "Camere" del pannello e vengono salvate in data/cameras.json.
# Questo file serve solo per le impostazioni del server.

# Dove ascolta il pannello. 127.0.0.1 = solo da questo computer.
# Il pannello non ha login proprio: chi lo raggiunge controlla le camere.
HOST=127.0.0.1
PORT=8080

# Facoltativo: file delle camere in un altro percorso
# CAMERAS_FILE=/percorso/cameras.json

# Facoltativo, compatibilità: se data/cameras.json non esiste ancora (e CAMERAS_FILE
# non è impostato), questa camera viene importata come "Camera 1" al primo avvio.
# CAM_URL=http://192.168.1.229
# CAM_USER=
# CAM_PASS=
